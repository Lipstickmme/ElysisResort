{
  "name": "elysis-luxury-resort",
  "version": "1.0.0",
  "description": "Elysis Luxury Resort website and API server: eighteen residences on Paros, with a reservations desk, concierge chat and shared mailbox behind it",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/build-pages.js && node --watch server.js",
    "build": "node scripts/build-pages.js",
    "prestart": "node scripts/build-pages.js",
    "placeholders": "node scripts/make-placeholders.js",
    "icons": "node scripts/make-brand-icons.js",
    "check:vercel": "node scripts/check-vercel-upload.js",
    "test": "node test/api.test.js",
    "test:browser": "node test/browser.test.js && node test/fallback.test.js",
    "optimise": "node scripts/optimise-images.js",
    "photos": "node scripts/photo-status.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "resort",
    "hotel",
    "express",
    "website"
  ],
  "author": "Elysis Luxury Resort",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
