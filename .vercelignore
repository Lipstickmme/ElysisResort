# Anchored with a leading slash on purpose. An unanchored pattern like "data/"
# matches at ANY depth, which would also exclude src/data (the content the
# build reads) and break the deploy.

# Local runtime storage at the repo root
/data/

# Not needed by the deployment
/docs/
/supabase/
/test/
/.github/
*.log

# The photography masters. The site serves the WebP copies beside them (see
# scripts/optimise-images.js), so the originals are 37 MB uploaded on every
# deploy and never requested. They stay in the repository as the masters.
/public/assets/img/*.png
/public/assets/img/*.jpg
/public/assets/img/*.jpeg

# Except the brand icons, which are served as PNG.
!/public/favicon.png
!/public/apple-touch-icon.png
